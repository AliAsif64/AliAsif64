# --- Database ---
# Postgres-compatible (works with Supabase). For Supabase: Project Settings >
# Database > Connection string (use the "Transaction" pooler URI on port 6543
# for serverless/edge deploys, or the direct 5432 URI otherwise).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dsr_solutions"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# --- AI Automation Suite (required for AI Assistant + AI automation actions) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Outbound email (required for "send email" automation actions, invoice emails, team invites) ---
# Any SMTP provider works: SendGrid, Postmark, Mailgun, Amazon SES, or a Gmail App Password.
# These can also be set per-organization from Settings > Integrations in the app instead of here.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="DSR Solutions <no-reply@example.com>"

# --- Subscription billing: DSR's OWN platform Stripe account ---
# This charges YOUR customers for their Business OS / AI Automation Suite
# subscription (see server/src/config/plans.ts for plans/prices). It is a
# separate Stripe account/key from the per-organization key below, which is
# each tenant's own Stripe account for collecting payment from THEIR clients'
# invoices.
STRIPE_SECRET_KEY=""
# From the Stripe Dashboard > Developers > Webhooks, pointed at
# {your-api-url}/api/billing/webhook, listening for: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=""

# --- Slack notifications (optional automation action) ---
# Configured per-organization in Settings > Integrations; no global env var needed.
