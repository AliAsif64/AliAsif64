# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# --- AI Automation Suite (required for AI Assistant + AI automation actions) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Outbound email (required for "send email" automation actions, invoice emails, team invites) ---
# Any SMTP provider works: SendGrid, Postmark, Mailgun, Amazon SES, or a Gmail App Password.
# These can also be set per-organization from Settings > Integrations in the app instead of here.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="DSR Solutions <no-reply@example.com>"

# --- Payments (optional - enables "Pay Now" on invoices via Stripe Checkout) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Slack notifications (optional automation action) ---
# Configured per-organization in Settings > Integrations; no global env var needed.
